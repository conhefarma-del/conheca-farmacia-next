# =============================================================================
# Conheça Farmácia — Environment Variables Template
# =============================================================================
# Copie este ficheiro para .env.local e preencha os valores reais.
# Em produção (Vercel), configure as mesmas variáveis no dashboard:
#   https://vercel.com/[project]/settings/environment-variables
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (públicas — podem ir para o browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase (privadas — só server-side, NUNCA expor)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://conhecafarmacia.com

# -----------------------------------------------------------------------------
# i18n Auto-Translation (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Hard-cap de caracteres PT traduzidos por dia (safety net contra runaway costs).
TRANSLATION_DAILY_CHAR_LIMIT=1000000
# Feature flag — quando false, todas as chamadas autoTranslateEntity retornam
# "translation disabled" sem chamar a API. Permite rollout gradual.
ENABLE_CONTENT_I18N=true

# -----------------------------------------------------------------------------
# Edge Functions internas (privada — só server-side, NUNCA expor)
# Segredo partilhado entre as Server Actions e as Edge Functions de email
# (send-newsletter-email, send-inscription-email): sem este header, a Edge
# responde 401. Configurar TAMBÉM nas secrets do Supabase (Edge Functions).
# -----------------------------------------------------------------------------
EDGE_INTERNAL_KEY=

# -----------------------------------------------------------------------------
# Revalidação on-demand da cache ISR (app/api/revalidate)
# Segredo partilhado para invalidar a cache depois de migrações aplicadas
# diretamente no SQL editor do Supabase. Uso:
#   curl "https://<site>/api/revalidate?secret=$REVALIDATE_SECRET&tag=interacoes"
# -----------------------------------------------------------------------------
REVALIDATE_SECRET=

# -----------------------------------------------------------------------------
# Área de conta (conta.conhecafarmacia.com)
# -----------------------------------------------------------------------------
# Domínio da cookie de sessão. SÓ em produção: é ele que faz www, conta e
# localizador verem a mesma sessão. Em Preview e em dev deixa VAZIO — numa
# preview *.vercel.app o browser recusa Domain=.conhecafarmacia.com e o login
# deixa de funcionar.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Origens usadas nos links da área de conta (vazio = produção).
NEXT_PUBLIC_ACCOUNT_ORIGIN=
NEXT_PUBLIC_LOCATOR_ORIGIN=
