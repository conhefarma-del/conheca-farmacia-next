# =============================================================================
# Conheça Farmácia — WhatsApp Bot · variáveis de ambiente
# -----------------------------------------------------------------------------
# 1. Copia este ficheiro para .env:   cp .env.example .env
# 2. Substitui TODOS os valores abaixo (nunca uses estes exemplos em produção).
# 3. Gera segredos com:   openssl rand -hex 32   (ou openssl rand -base64 32)
# 4. Aponta os teus subdomínios (DNS) para o IP público da VPS antes de
#    arrancar o Caddy (senão o HTTPS automático não emite certificados).
# =============================================================================

# ---- Domínios (substitui exemplo.com pelos teus) ---------------------------
N8N_HOST=n8n.exemplo.com
EVOLUTION_HOST=evo.exemplo.com

# ---- n8n --------------------------------------------------------------------
# Segredo de encriptação das credenciais guardadas nos workflows (OBRIGATÓRIO)
N8N_ENCRYPTION_KEY=troca-por-segredo-longo-gerado-com-openssl
# Acesso ao painel do n8n (basic auth — por trás do Caddy + HTTPS)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troca-por-palavra-passe-forte

# ---- Evolution API ----------------------------------------------------------
# API key para todas as chamadas à Evolution (header "apikey") — OBRIGATÓRIO
EVOLUTION_API_KEY=troca-por-api-key-longa-gerada-com-openssl
# Segredo de assinatura dos webhooks (a Evolution assina os eventos com ele)
EVOLUTION_WEBHOOK_SECRET=troca-por-outro-segredo-gerado-com-openssl
# URL do webhook no n8n — O webhook node deve ter o path /evolution
# Ex.: https://n8n.exemplo.com/webhook/evolution
EVOLUTION_WEBHOOK_URL=https://n8n.exemplo.com/webhook/evolution
# Eventos que disparam o webhook (deixa os de mensagens; ajusta conforme o uso)
EVOLUTION_WEBHOOK_EVENTS=MESSAGES_UPSERT,MESSAGES_UPDATE,MESSAGES_DELETE

# ---- Bases de dados (Postgres separado por serviço) -------------------------
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=troca-por-palavra-passe-forte
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=troca-por-outra-palavra-passe-forte

# ---- Diversos ---------------------------------------------------------------
# Fuso horário do n8n (Angola)
GENERIC_TIMEZONE=Africa/Luanda
